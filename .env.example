# GitHub Personal Access Token
# Create one at: https://github.com/settings/tokens
# Required scopes for public repos: (no special scopes needed, just a classic token)
GITHUB_TOKEN=your_github_token_here

# PostgreSQL (used by `python run_pipeline.py export`)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=engineeringpulse
DB_USER=postgres
DB_PASSWORD=postgres
